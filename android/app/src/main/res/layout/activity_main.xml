<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Mirino: tutto il fotogramma 4:3 della lente -->
    <com.dualframe.cam.AspectFrameLayout
        android:id="@+id/viewfinder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#FF1B2633">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <com.dualframe.cam.FrameOverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/flashView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="#FFFFFFFF"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_pill_overlay"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="26dp"
            android:paddingStart="12dp"
            android:paddingTop="3dp"
            android:paddingEnd="12dp"
            android:paddingBottom="3dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </com.dualframe.cam.AspectFrameLayout>

    <!-- In alto tutte le impostazioni -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/bg"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/topRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="46dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnFlash"
                style="@style/IconButton"
                android:contentDescription="@string/cd_flash"
                android:src="@drawable/ic_flash_off" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipRes"
                    style="@style/Chip"
                    android:text="1080p ▾" />

                <TextView
                    android:id="@+id/chipFps"
                    style="@style/Chip"
                    android:layout_marginStart="5dp"
                    android:text="30 fps ▾" />

                <TextView
                    android:id="@+id/chipCodec"
                    style="@style/Chip"
                    android:layout_marginStart="5dp"
                    android:text="HEVC ▾" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnGrid"
                style="@style/IconButton"
                android:contentDescription="@string/cd_grid"
                android:src="@drawable/ic_grid" />
        </LinearLayout>

        <!-- Seconda riga: lente, messa a fuoco, diaframma -->
        <LinearLayout
            android:id="@+id/chips2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/lensRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_lens"
                android:orientation="horizontal"
                android:padding="2dp" />

            <TextView
                android:id="@+id/chipFocus"
                style="@style/Chip"
                android:layout_marginStart="10dp"
                android:text="Fuoco AUTO ▾" />

            <TextView
                android:id="@+id/chipAperture"
                style="@style/Chip"
                android:layout_marginStart="5dp"
                android:text="f/1.9 ▾" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pannello di scelta che si apre toccando un chip -->
    <LinearLayout
        android:id="@+id/menuPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/menuOptions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/menuSeekRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="∞"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <SeekBar
                android:id="@+id/focusSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Macro"
                android:textColor="@color/text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/menuNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_pill_dark"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Comandi in basso -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/processing"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_pill_dark"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/modeRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/modePhoto"
                style="@style/ModeLabel"
                android:text="@string/mode_photo" />

            <TextView
                android:id="@+id/modeVideo"
                style="@style/ModeLabel"
                android:layout_marginStart="20dp"
                android:text="@string/mode_video" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:paddingStart="36dp"
            android:paddingEnd="36dp">

            <ImageView
                android:id="@+id/gallery"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_thumb"
                android:clipToOutline="true"
                android:contentDescription="@string/cd_gallery"
                android:padding="2dp"
                android:scaleType="centerCrop" />

            <com.dualframe.cam.ShutterButton
                android:id="@+id/shutter"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_shutter" />

            <ImageButton
                android:id="@+id/btnRecenter"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_circle"
                android:contentDescription="@string/cd_recenter"
                android:src="@drawable/ic_recenter" />

            <ImageButton
                android:id="@+id/btnSnap"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="@string/cd_snap"
                android:src="@drawable/ic_camera"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Richiesta permessi -->
    <LinearLayout
        android:id="@+id/permissionView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/permission_text"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/accent"
            android:text="@string/permission_button"
            android:textColor="@color/ink" />
    </LinearLayout>
</FrameLayout>
